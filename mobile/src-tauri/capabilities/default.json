{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://*/*" },
        { "url": "http://*/*" },
        { "url": "http://localhost:3001/*" },
        { "url": "http://localhost:3001/**" },
        { "url": "http://127.0.0.1:3001/*" },
        { "url": "http://127.0.0.1:3001/**" }
      ]
    }
  ]
}

